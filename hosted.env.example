# Copy to hosted.env (git ignores it) and fill in from the Firebase console.
# Project settings > General: "Project ID"
TEXTILE_PROJECT=your-project-id
# Project settings > General > Your apps > Web app > SDK setup and configuration: "apiKey"
EXPO_PUBLIC_API_KEY=your-web-api-key
# Optional, only if you use a service-account key instead of gcloud:
# GOOGLE_APPLICATION_CREDENTIALS=C:\Users\you\keys\textilesense-admin.json
